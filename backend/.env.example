# CallMissed API Configuration
# Get your API key from https://console.callmissed.com/developer/keys
CALLMISSED_API_KEY=cm_your_api_key_here
CALLMISSED_BASE_URL=https://api.callmissed.com

# Server Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Set to true for mock development/testing without real credits
CALLMISSED_MOCK_MODE=false
